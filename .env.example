# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project → Settings → Environment Variables.

# --- Site ---------------------------------------------------------------------
# Public origin of the site, used for auth redirects, emails and the sitemap.
NEXT_PUBLIC_SITE_URL=

# --- Supabase -----------------------------------------------------------------
# Project Settings → API. The publishable (anon) key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (service role) key. Used for webhooks, refunds, rate
# limiting and email logs. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Online payments (optional) ------------------------------------------------
# Leave PAYMENT_PROVIDER empty to offer cash on delivery only.
# Supported: stripe
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional) -----------------------------------------------------------
# Transactional email via Resend. Without these, emails are logged as "skipped".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Scheduled jobs ---------------------------------------------------------------
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Tests (optional) -------------------------------------------------------------
# Playwright end-to-end tests against a running app with a seeded Supabase project.
E2E_BASE_URL=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
