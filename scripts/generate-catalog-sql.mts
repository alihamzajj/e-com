// Writes supabase/seed-catalog-expansion.sql from the starter catalog in
// src/features/catalog/demo-data.ts: the category tree (Leather Goods, Watches,
// Mobile Accessories and their subcategories), the new products, and moves the
// original products into their new subcategories. Safe to run more than once and
// keeps anything already edited in the admin. Run: npm run db:catalog
import { writeFileSync } from "node:fs";
import path from "node:path";
import { CATEGORY_DEFS, IMG, PRODUCTS, colorOf, optionNamesOf, variantsOf } from "../src/features/catalog/demo-data.ts";

// Products 1–16 came with supabase/seed-store.sql; these are where they used to live.
const ORIGINAL_CATEGORY: Record<string, string> = {
  "everyday-wear": "clothing",
  "sneakers": "shoes",
  "formal-shoes": "shoes",
  "belts": "accessories",
};
const NEW_FROM = 17;

const q = (v: string | null) => (v == null ? "null" : `'${v.replace(/'/g, "''")}'`);
const catId = (slug: string) => `(select id from public.categories where slug = ${q(slug)})`;
const productRef = (slug: string) => `(select id from public.products where slug = ${q(slug)})`;
const code = (s: string, n: number) => s.replace(/[^A-Za-z0-9]/g, "").toUpperCase().slice(0, n);

const out: string[] = [
  "-- =============================================================================",
  "-- GHANI TRADERS CATALOG EXPANSION. Generated by `npm run db:catalog` from",
  "-- src/features/catalog/demo-data.ts; edit that file, not this one.",
  "-- Run in the SQL Editor AFTER supabase/seed-store.sql (and after the migration",
  "-- 20261026000007_catalog_option_filters.sql). Safe to run again: existing rows",
  "-- and anything changed in the admin are left alone.",
  "-- =============================================================================",
  "",
  "begin;",
  "",
  "-- Broader store copy, only where the original starter text is still in place.",
  `update public.store_settings set tagline = 'Everything you need, in one place.'`,
  `where id = 1 and tagline = 'Considered clothing and leather goods for every day.';`,
  `update public.store_settings set hero = hero || jsonb_build_object('subtitle', ${q(
    "Leather jackets, belts, shoes, watches and mobile accessories, chosen to be used every day and kept for years.",
  )})`,
  `where id = 1 and hero ->> 'subtitle' = 'Everyday clothing, leather bags and shoes, designed to be worn often and kept for years.';`,
  "",
  "-- Categories: top level first so subcategories can point at their parent.",
];

CATEGORY_DEFS.forEach((c, i) => {
  out.push(
    `insert into public.categories (id, name, slug, description, image_url, sort_order, parent_id)`,
    `values (${q(c.id)}, ${q(c.name)}, ${q(c.slug)}, ${q(c.description)}, ${q(`${IMG}/${c.image}.webp`)}, ${i + 1}, ${c.parent ? catId(c.parent) : "null"})`,
    `on conflict (slug) do update set parent_id = excluded.parent_id, sort_order = excluded.sort_order;`,
  );
});
out.push(
  `update public.categories set description = 'Scarves and caps.' where slug = 'accessories' and description = 'Scarves, caps and belts.';`,
  `update public.categories set description = 'Leather jackets and everyday essentials.' where slug = 'clothing' and description = 'Everyday essentials and seasonal pieces.';`,
  `update public.categories set description = 'Sneakers, formal shoes and boots.' where slug = 'shoes' and description = 'Sneakers and loafers made to be worn daily.';`,
  "",
  "-- Move the original products into their new subcategories (only if still where the starter catalog put them).",
);
for (const p of PRODUCTS.filter((x) => x.n < NEW_FROM && ORIGINAL_CATEGORY[x.category])) {
  out.push(
    `update public.products set category_id = ${catId(p.category)} where slug = ${q(p.slug)} and category_id = ${catId(ORIGINAL_CATEGORY[p.category])};`,
  );
}

const fresh = PRODUCTS.filter((p) => p.n >= NEW_FROM);
out.push("", "-- New products.");
for (const p of fresh) {
  const specs = JSON.stringify(p.specs.map(([label, value]) => ({ label, value })));
  out.push(
    `insert into public.products (category_id, name, slug, short_description, description, specifications, option_names, price, sale_price, status, is_featured, low_stock_threshold, published_at)`,
    `values (${catId(p.category)}, ${q(p.name)}, ${q(p.slug)}, ${q(p.short)}, ${q(p.description)}, ${q(specs)}, ${q(`{${optionNamesOf(p).map((n) => `"${n}"`).join(",")}}`)}, ${p.price}, ${p.sale ?? "null"}, 'active', ${Boolean(p.featured)}, 5, now() - interval '${p.daysOld} days')`,
    `on conflict (slug) do nothing;`,
  );
}

out.push("", "insert into public.product_variants (product_id, sku, title, options, price, sale_price, stock_quantity, position) values");
const variantRows = fresh.flatMap((p) => {
  const base = `GT-${p.name.split(/\s+/).slice(0, 3).map((w) => code(w, 3)).join("")}`;
  return variantsOf(p).map((v) => {
    const sku = [base, code(colorOf(v.color), 3), ...Object.entries(v.options).filter(([k]) => k !== "Color").map(([, val]) => code(val, 12))].join("-");
    return `  (${productRef(p.slug)}, ${q(sku)}, ${q(v.title)}, ${q(JSON.stringify(v.options))}, null, null, ${v.stock}, ${v.position + 1})`;
  });
});
out.push(variantRows.join(",\n"), "on conflict (sku) do nothing;");

out.push("", "insert into public.product_images (product_id, url, alt, position)", "select p.id, v.url, v.alt, v.position from (values");
const imageRows = fresh.flatMap((p) => p.colors.map((c, i) => `  (${q(p.slug)}, ${q(`${IMG}/${c}.webp`)}, ${q(`${p.name} in ${colorOf(c)}`)}, ${i})`));
out.push(
  imageRows.join(",\n"),
  ") as v(slug, url, alt, position)",
  "join public.products p on p.slug = v.slug",
  "where not exists (select 1 from public.product_images i where i.product_id = p.id and i.url = v.url);",
  "",
  "commit;",
  "",
);

const file = path.join(process.cwd(), "supabase", "seed-catalog-expansion.sql");
writeFileSync(file, out.join("\n"));
console.log(`Wrote ${path.relative(process.cwd(), file)} (${fresh.length} new products, ${variantRows.length} variants)`);
